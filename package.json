{
  "name": "@epubcheck-ts/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp run -r test",
    "check": "vp run fmt:check && vp run lint && vp run typecheck && vp run test",
    "conformance": "node conformance/src/bin.ts",
    "conformance:check": "node conformance/src/bin.ts check",
    "conformance:diff": "node conformance/src/bin.ts diff",
    "sync:upstream": "node scripts/sync-upstream.ts",
    "fetch:epubcheck-jar": "node scripts/fetch-epubcheck-jar.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@12.15.0"
}
