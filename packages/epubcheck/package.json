{
  "name": "epubcheck-ts",
  "version": "0.0.0",
  "description": "Independent TypeScript rewrite of W3C EPUBCheck, built on Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielphan2003/epubcheck-ts",
    "directory": "packages/epubcheck"
  },
  "bin": {
    "epubcheck-ts": "./src/bin.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./promise": {
      "types": "./src/promise.ts",
      "import": "./src/promise.ts"
    }
  },
  "publishConfig": {
    "bin": {
      "epubcheck-ts": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./promise": {
        "types": "./dist/promise.d.ts",
        "import": "./dist/promise.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md .",
    "postpack": "rm -f LICENSE THIRD_PARTY_NOTICES.md"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:",
    "fontoxpath": "^3.34.0",
    "saxes": "^6.0.0",
    "slimdom": "^4.3.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
